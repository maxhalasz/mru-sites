---
import NewsItem from '../../../views/NewsItem.astro';
import { getCollection } from 'astro:content';
import { isLive } from '../../../i18n';

export async function getStaticPaths() {
  const news = await getCollection('news', (n) => isLive(n.data));
  return news.map((n) => ({ params: { slug: n.id }, props: { item: n } }));
}
const { item } = Astro.props;
---
<NewsItem lang="en" item={item} />
