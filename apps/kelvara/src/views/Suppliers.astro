---
import Base from '../layouts/Base.astro';
import { paths, label, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (no: string, en: string) => (lang === 'no' ? no : en);
---
<Base lang={lang} page="suppliers" title={label[lang].suppliers}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href={paths[lang].home}>{label[lang].home}</a> / {label[lang].suppliers}</div>
      <h1>{label[lang].suppliers}</h1>
      <p>{t('Kvalifisering og fakturering for leverandører til Kelvara.', 'Qualification and invoicing for suppliers to Kelvara.')}</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap grid c2" style="gap:3rem;align-items:start">
      <div class="prose">
        <h2>{t('Kvalifisering', 'Qualification')}</h2>
        <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{t('Alle som skal levere varer eller tjenester til Ødemark A, forsyningsbasen eller væskeanlegget, må være kvalifisert før første leveranse. Kvalifiseringen omfatter:', 'Everyone who delivers goods or services to Ødemark A, the supply base or the fluids plant must be qualified before the first delivery. Qualification covers:')}</p>
        <ul>
          <li>{t('Registrering i Enhetsregisteret og gyldige skatte- og avgiftsattester', 'Registration in the Register of Business Enterprises and valid tax and VAT certificates')}</li>
          <li>{t('HMS-egenerklæring og oversikt over skader og hendelser siste tre år', 'HSE self-declaration and an overview of injuries and incidents over the last three years')}</li>
          <li>{t('Forsikringsbevis', 'Proof of insurance')}</li>
          <li>{t('Redegjørelse for aktsomhetsvurderinger etter åpenhetsloven', 'Statement on due diligence assessments under the Transparency Act')}</li>
        </ul>
        <p>{t('Send forespørsler om kvalifisering til innkjøp. Vi svarer innen fem arbeidsdager.', 'Send qualification enquiries to procurement. We reply within five working days.')}</p>
        <p><a href="mailto:innkjop@kelvara.example">innkjop@kelvara.example</a></p>
      </div>
      <div class="prose">
        <h2>{t('Elektronisk faktura', 'Electronic invoicing')}</h2>
        <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{t('Kelvara tar bare imot elektroniske fakturaer i EHF-format. Papirfakturaer og PDF på e-post behandler vi ikke.', 'Kelvara only accepts electronic invoices in EHF format. We do not process paper invoices or PDFs sent by email.')}</p>
        <div class="table-wrap">
          <table>
            <tbody>
              <tr><th scope="row">{t('Fakturamottaker', 'Invoice recipient')}</th><td>Kelvara Petrochemicals AS</td></tr>
              <tr><th scope="row">{t('Organisasjonsnummer', 'Organisation number')}</th><td class="doc-no">921 447 306 MVA</td></tr>
              <tr><th scope="row">{t('Format', 'Format')}</th><td>EHF / Peppol BIS Billing 3.0</td></tr>
              <tr><th scope="row">{t('Mottaker-ID', 'Receiver ID')}</th><td class="doc-no">9908:921447306</td></tr>
              <tr><th scope="row">{t('Merk fakturaen med', 'Reference on invoice')}</th><td>{t('Bestillingsnummer (KV-PO-…) og kontaktperson', 'Purchase order number (KV-PO-…) and contact person')}</td></tr>
            </tbody>
          </table>
        </div>
        <p class="small muted" style="margin-top:1rem">{t('Betalingsfrist er 30 dager fra fakturadato.', 'Payment terms are 30 days from invoice date.')}</p>
      </div>
    </div>
  </section>
</Base>
