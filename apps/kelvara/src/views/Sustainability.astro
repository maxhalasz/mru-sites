---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { paths, label, ui, dateFmt, isLive, isFuture, isoDay, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (no: string, en: string) => (lang === 'no' ? no : en);
const docs = (await getCollection('documents', (d) => isLive(d.data))).sort((a, b) => +b.data.date - +a.data.date);
---
<Base lang={lang} page="sustainability" title={label[lang].sustainability}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href={paths[lang].home}>{label[lang].home}</a> / {label[lang].sustainability}</div>
      <h1>{label[lang].sustainability}</h1>
      <p>{t('Utslipp, lokalsamfunn og ansvarlige leverandørkjeder.', 'Emissions, local communities and responsible supply chains.')}</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap prose">
      <h2>{t('Utslipp', 'Emissions')}</h2>
      <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
      <p>{t('Strømmen på Ødemark A kommer fra gassturbiner, og med så lite mannskap er utslippene lave sammenlignet med større installasjoner. I 2027 slapp vi ut 6,9 kilo CO₂ per fat oljeekvivalent, mot 7,6 kilo i 2024.', 'Power on Ødemark A comes from gas turbines, and with such a small crew emissions are low compared with larger installations. In 2027 we emitted 6.9 kilograms of CO₂ per barrel of oil equivalent, against 7.6 kilograms in 2024.')}</p>
      <p>{t('Vi jobber videre med varmegjenvinning på turbinene og planlegger forsyningsturene bedre for å bruke mindre drivstoff.', 'We are continuing work on heat recovery from the turbines and planning supply runs better to use less fuel.')}</p>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap prose">
      <h2>{t('Lokalsamfunn og sponsing', 'Community and sponsorship')}</h2>
      <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
      <p>{t('Kelvara er hovedsponsor for redningsskøyta RS 138 «Sotrabuen», som Redningsselskapet driver med frivillig mannskap. Vi er også med på karrieremesser ved videregående skoler i regionen, og vi tar inn lærlinger hvert år.', 'Kelvara is main sponsor of the rescue vessel RS 138 «Sotrabuen», which the Norwegian Society for Sea Rescue runs with a volunteer crew. We also attend careers fairs at upper secondary schools in the region, and we take on apprentices every year.')}</p>
      <p data-date="2028-08-18"><a href={`${paths[lang].news}2028-08-18-hovedsponsor-sotrabuen/`}>{t('Les om sponsoravtalen', 'Read about the sponsorship agreement')}</a></p>
    </div>
  </section>

  <section class="band" id="apenhetsloven">
    <div class="wrap prose">
      <h2>{t('Åpenhetsloven', 'Transparency Act')}</h2>
      <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
      <p>{t('Åpenhetsloven krever at vi kartlegger risikoen for brudd på menneskerettigheter og anstendige arbeidsforhold, både i egen virksomhet og hos leverandørene. Redegjørelsen for 2027 ligger her.', 'The Transparency Act requires us to assess the risk of human rights violations and indecent working conditions, in our own business and among our suppliers. The statement for 2027 is here.')}</p>
      <ul class="list-plain">
        {docs.map((d) => (
          <li data-date={isoDay(d.data.date)} hidden={isFuture(d.data.date)}>
            <p style="margin:0"><b>{lang === 'no' ? d.data.title_no : d.data.title_en}</b> <span class="muted small">· {dateFmt(d.data.date, lang)}</span></p>
            <p class="small" style="margin:.3rem 0 0"><a href={lang === 'no' ? d.data.file_no : d.data.file_en}>{ui[lang].download}</a></p>
          </li>
        ))}
      </ul>
      <p><a href={paths[lang].transparency}>{t('Be om opplysninger etter åpenhetsloven', 'Request information under the Transparency Act')}</a></p>
    </div>
  </section>
</Base>
