---
import Base from '../layouts/Base.astro';
import { paths, label, ui, dateFmt, type Lang } from '../i18n';

interface Props { lang: Lang; item: any }
const { lang, item } = Astro.props;
const d = item.data;
const title = lang === 'no' ? d.title_no : d.title_en;
const body = (lang === 'no' ? d.body_no : d.body_en).split(/\n\s*\n/);
const alt = `${paths[lang === 'no' ? 'en' : 'no'].news}${item.id}/`;
---
<Base lang={lang} page="news" title={title} description={lang === 'no' ? d.summary_no : d.summary_en} altPath={alt}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href={paths[lang].home}>{label[lang].home}</a> / <a href={paths[lang].news}>{label[lang].news}</a></div>
      <p class="muted small" style="margin:0 0 .8rem;color:#bbb">{dateFmt(d.date, lang)}</p>
      <h1 style="max-width:30ch;text-transform:none;font-size:clamp(1.3rem,3vw,2rem)">{title}</h1>
    </div>
  </div>
  <section class="band">
    <div class="wrap prose">
      {body.map((p: string) => <p>{p}</p>)}
      <p style="margin-top:2rem"><a href={paths[lang].news}>{ui[lang].back}</a></p>
    </div>
  </section>
</Base>
