---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import OdemarkSchematic from '../components/OdemarkSchematic.astro';
import { paths, label, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (no: string, en: string) => (lang === 'no' ? no : en);
const facts: [string, string][] = [
  [t('Type', 'Type'), t('Betongplattform med gravitasjonsbasert understell (Condeep)', 'Concrete platform with gravity-base substructure (Condeep)')],
  [t('Vanndybde', 'Water depth'), '303 m'],
  [t('Topside', 'Topside'), t('114 × 55 m, tre nivåer', '114 × 55 m, three levels')],
  [t('Kapasitet', 'Capacity'), t('Dimensjonert for 196 personer', 'Designed for 196 persons')],
  [t('Bemanning', 'Staffing'), t('Drives med lav bemanning', 'Operated with a lean crew')],
  [t('Område', 'Area'), t('Nordlige Norskehavet', 'Northern Norwegian Sea')],
  [t('Posisjon', 'Position'), '71°00′N 4°30′E'],
  [t('Utvinningstillatelse', 'Production licence'), 'PL 188'],
  [t('Operatør', 'Operator'), t('Kelvara Petrochemicals AS, siden 2011', 'Kelvara Petrochemicals AS, since 2011')],
];
---
<Base lang={lang} page="operations" title={label[lang].operations}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href={paths[lang].home}>{label[lang].home}</a> / {label[lang].operations}</div>
      <h1>{label[lang].operations}</h1>
      <p>{t('Ødemark A, forsyningsbasen og væskeanlegget på Ågotnes.', 'Ødemark A, the supply base and the fluids plant at Ågotnes.')}</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap grid c2" style="gap:3rem;align-items:start">
      <div>
        <p class="eyebrow">Ødemark A</p>
        <h2>{t('Plattformen', 'The platform')}</h2>
        <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{t('Ødemark A er en Condeep-plattform. Understellet er av betong, står på havbunnen og holdes på plass av sin egen vekt. Det rommer lagerceller og tre skaft som bærer topsiden over havflaten.', 'Ødemark A is a Condeep platform. The substructure is concrete, rests on the seabed and is held in place by its own weight. It contains storage cells and three shafts that carry the topside above the sea.')}</p>
        <p>{t('Topsiden måler 114 × 55 meter og har tre nivåer. Plattformen er bygget for 196 personer, men drives med lav bemanning: et lite mannskap der hver person dekker flere funksjoner.', 'The topside measures 114 × 55 metres and has three levels. The platform is designed for 196 people but runs on a lean crew, a small group in which each person covers several functions.')}</p>
      </div>
      <div class="table-wrap" style="align-self:center">
        <table><tbody>{facts.map(([k, v]) => <tr><th scope="row" style="width:34%">{k}</th><td>{v}</td></tr>)}</tbody></table>
      </div>
    </div>
  </section>

  <section class="band alt" id="tegning">
    <div class="wrap">
      <OdemarkSchematic lang={lang} />
    </div>
  </section>

  <section class="band alt" id="agotnes">
    <div class="wrap grid c2" style="gap:3rem;align-items:center">
      <Placeholder file="agotnes-vaeskeanlegg.jpg" ratio="4 / 3" class="light" label={t('Ågotnes Væskeanlegg og forsyningsbasen', 'Ågotnes Væskeanlegg and the supply base')} />
      <div>
        <p class="eyebrow">Ågotnes</p>
        <h2>{t('Forsyningsbase og væskeanlegg', 'Supply base and fluids plant')}</h2>
        <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{t('Basen på Ågotnes er Kelvaras forsyningsledd til Ødemark A. Forsyningsbåten MS Nordvakt, som drives av Aegis Corporation, går herfra, og her lagres utstyr og forbruksvarer.', 'The base at Ågotnes is Kelvara\'s supply link to Ødemark A. The supply vessel MS Nordvakt, operated by Aegis Corporation, sails from here, and equipment and consumables are stored here.')}</p>
        <p>{t('Ågotnes Væskeanlegg ligger ved siden av basen. Anlegget blander og lagrer borevæsker og leverer til Ødemark A og til andre operatører. Det åpnet i 2014.', 'Ågotnes Væskeanlegg lies next to the base. The plant mixes and stores drilling fluids and supplies Ødemark A and other operators. It opened in 2014.')}</p>
      </div>
    </div>
  </section>

  <section class="band" id="vinter">
    <div class="wrap prose">
      <p class="eyebrow">{t('Vinterdrift', 'Winter operations')}</p>
      <h2>{t('Lang rotasjon om vinteren', 'Long rotation in winter')}</h2>
      <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
      <p>{t('Fra 1. november går Ødemark A over til vinterplan. Mannskapet signerer på for hele sesongen frem til våren, fordi været i det nordlige Norskehavet gjør vanlige mannskapsbytter og forsyningsturer usikre.', 'From 1 November, Ødemark A moves to its winter schedule. The crew sign on for the whole season until spring, because the weather in the northern Norwegian Sea makes ordinary crew changes and supply runs unreliable.')}</p>
      <p>{t('I de mørkeste ukene følger installasjonen Kelvaras Mørketid-rutiner: faste tider for dagslyslamper, jevnlig kontakt med familien på land og tett oppfølging fra legen om bord.', 'In the darkest weeks the installation follows Kelvara\'s Mørketid routines: set times for the daylight lamps, regular contact with family onshore and close follow-up from the medic on board.')}</p>
      <p data-date="2028-09-05"><a href={`${paths[lang].news}2028-09-05-vinterdrift-2028-29/`}>{t('Les mer om vinterdriften 2028/29', 'Read more about winter operations 2028/29')}</a></p>
    </div>
  </section>
</Base>
