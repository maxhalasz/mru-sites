---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import HeroArt from '../components/HeroArt.astro';
import { getCollection } from 'astro:content';
import { paths, label, ui, dateFmt, isLive, isFuture, isoDay, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (no: string, en: string) => (lang === 'no' ? no : en);
const news = (await getCollection('news', (n) => isLive(n.data))).sort((a, b) => +b.data.date - +a.data.date);
const newsShown = news.filter((n) => !isFuture(n.data.date)).slice(0, 3).map((n) => n.id);
const jobs = (await getCollection('jobs', (j) => isLive(j.data))).sort((a, b) => a.data.order - b.data.order);
const jobsAttr = jobs.map((j) => `${j.data.reference}:${isoDay(j.data.date)}`).join(',');
const newsPath = (id: string) => `${paths[lang].news}${id}/`;
const facts: [string, string][] = [
  ['303 m', t('vanndybde', 'water depth')],
  ['114 × 55 m', t('topside, tre nivåer', 'topside, three levels')],
  ['196', t('personer, dimensjonert kapasitet', 'persons, design capacity')],
  ['2011', t('operatør siden', 'operator since')],
];
---
<Base lang={lang} page="home" title={t('Forside', 'Home')}>
  <section class="hero">
    <HeroArt />
    <div class="wrap">
      <p class="eyebrow">Kelvara Petrochemicals AS</p>
      <h1>{t('Trygg drift i nordlige Nordsjøen', 'Safe operations in the northern North Sea')}</h1>
      <p>{t('Vi driver Ødemark A med et lite mannskap som kjenner plattformen godt, og forsyner den fra basen på Ågotnes.', 'We run Ødemark A with a small crew that knows the platform well, and supply it from our base at Ågotnes.')}</p>
      <p class="btns">
        <a class="btn" href={`${paths[lang].careers}#stillinger`}>{t('Se ledige stillinger', 'See open positions')}</a>
        <a class="btn ghost" href={paths[lang].operations}>{t('Om virksomheten', 'About our operations')}</a>
      </p>
    </div>
  </section>

  <section class="band vacancy-band" aria-label={t('Ledige stillinger', 'Open positions')} data-vac-zero="hide" data-jobs={jobsAttr}>
    <div class="wrap">
      <div class="vb">
        <div>
          <p class="eyebrow">{t('Vi trenger deg', 'We need you')}</p>
          <h2 data-vac="headline" data-jobs={jobsAttr}>{t('Tre ledige stillinger til vintersesongen', 'Three open positions for the winter season')}</h2>
          <p>{t('Oppstart 28. oktober 2028. Vi kaller deg inn til intervju så snart søknaden er kommet.', 'Start 28 October 2028. We will call you in for an interview as soon as your application arrives.')}</p>
        </div>
        <ul class="chips">
          {jobs.map((j) => (
            <li data-job={j.data.reference} data-date={isoDay(j.data.date)} hidden={isFuture(j.data.date)}><a href={`${paths[lang].careers}#${j.data.reference.toLowerCase()}`}><b>{lang === 'no' ? j.data.title_no : j.data.title_en}</b><span>{lang === 'no' ? j.data.subtitle_no : j.data.subtitle_en}</span></a></li>
          ))}
        </ul>
        <p class="go"><a class="btn" href={`${paths[lang].careers}#stillinger`}>{t('Se stillingene og søk', 'See the positions and apply')}</a></p>
      </div>
    </div>
  </section>

  <section class="band dark">
    <div class="wrap">
      <div class="facts">
        {facts.map(([n, d]) => <div class="fact"><b>{n}</b><span>{d}</span></div>)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap grid c2" style="gap:3rem;align-items:center">
      <div>
        <p class="eyebrow">{label[lang].about}</p>
        <h2>{t('Et selskap bygget rundt én plattform', 'A company built around one platform')}</h2>
        <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{t('Kelvara ble stiftet i 2011 for å kjøpe Ødemark A og få plattformen i produksjon igjen. I dag driver vi plattformen, forsyningsbasen og væskeanlegget på Ågotnes. ', 'Kelvara was founded in 2011 to buy Ødemark A and get it producing again. We now run the platform, the supply base and the fluids plant at Ågotnes.')} <span data-date="2028-09-24">{t('Siden 24. september 2028 eies alle aksjene i Kelvara av NeuroStat Holding AG.', 'Since 24 September 2028 all shares in Kelvara have been held by NeuroStat Holding AG.')}</span></p>
        <p><a href={paths[lang].about}>{ui[lang].readMore}</a></p>
      </div>
      <Placeholder file="agotnes-base.jpg" ratio="4 / 3" class="light" label={t('Forsyningsbasen på Ågotnes', 'The supply base at Ågotnes')} />
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem">
        <div><p class="eyebrow">{label[lang].news}</p><h2>{t('Siste nytt', 'Latest news')}</h2></div>
        <a href={paths[lang].news}>{ui[lang].allNews}</a>
      </div>
      <div class="grid c3" data-limit="3">
        {news.map((n) => (
          <a class="card" href={newsPath(n.id)} style="text-decoration:none;color:inherit" data-date={isoDay(n.data.date)} hidden={!newsShown.includes(n.id)}>
            <p class="muted small" style="margin-bottom:.6rem">{dateFmt(n.data.date, lang)}</p>
            <h3>{lang === 'no' ? n.data.title_no : n.data.title_en}</h3>
            <p class="muted small">{lang === 'no' ? n.data.summary_no : n.data.summary_en}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band dark">
    <div class="wrap grid c2" style="gap:3rem;align-items:center">
      <div>
        <p class="eyebrow">{label[lang].careers}</p>
        <h2>{t('Jobb med oss', 'Work with us')}</h2>
        <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{t('Vi vil ha folk som kan faget og som passer på hverandre.', 'We want people who know their trade and look out for each other.')} <span data-vac="now" data-jobs={jobsAttr}>{t('Akkurat nå er tre stillinger ledige på Ødemark A.', 'Right now three positions are open on Ødemark A.')}</span></p>
      </div>
      <p><a class="btn" href={paths[lang].careers}>{t('Se ledige stillinger', 'See open positions')}</a></p>
    </div>
  </section>
</Base>
