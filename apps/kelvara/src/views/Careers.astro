---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { getCollection } from 'astro:content';
import { paths, label, dateFmt, SITE_DATE, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (no: string, en: string) => (lang === 'no' ? no : en);
const quotes = (await getCollection('testimonials', (q) => q.data.published)).sort((a, b) => a.data.order - b.data.order);
const jobs = (await getCollection('jobs', (j) => j.data.published && j.data.date <= SITE_DATE)).sort((a, b) => a.data.order - b.data.order);
const slug = (n: string) => n.toLowerCase().replace(/[^a-z]+/g, '-');
const lines = (s: string) => s.split('\n').filter(Boolean);
---
<Base lang={lang} page="careers" title={label[lang].careers}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href={paths[lang].home}>{label[lang].home}</a> / {label[lang].careers}</div>
      <h1>{label[lang].careers}</h1>
      <p>{t('Jobb på Ødemark A, på Ågotnes og i Stavanger.', 'Work on Ødemark A, at Ågotnes and in Stavanger.')}</p>
    </div>
  </div>

  <section class="band vacancies" id="stillinger">
    <div class="wrap">
      <p class="eyebrow">{t('Ledige stillinger', 'Open positions')}</p>
      <h2>{t(`${jobs.length} stillinger til vintersesongen`, `${jobs.length} positions for the winter season`)}</h2>
      <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="lead">{t('Bemanningen for vinteren 2028/29 er nesten komplett. Disse tre er de siste ledige stillingene på Ødemark A. Vi leser søknadene etter hvert som de kommer og kaller inn til intervju med en gang.', 'The crew for winter 2028/29 is almost complete. These three are the last open positions on Ødemark A. We read applications as they come in and call people in for interviews straight away.')}</p>
      <div class="grid c3 jobs">
        {jobs.map((j) => (
          <article class="job" id={j.data.reference.toLowerCase()}>
            <span class="tag new">{t('Ledig', 'Open')}</span>
            <h3>{lang === 'no' ? j.data.title_no : j.data.title_en}</h3>
            <p class="sub">{lang === 'no' ? j.data.subtitle_no : j.data.subtitle_en}</p>
            <p class="meta"><span>{j.data.location}</span><span>{lang === 'no' ? j.data.rotation_no : j.data.rotation_en}</span></p>
            <p>{lang === 'no' ? j.data.summary_no : j.data.summary_en}</p>
            <details>
              <summary>{t('Kvalifikasjoner', 'Requirements')}</summary>
              <ul>{lines(lang === 'no' ? j.data.requirements_no : j.data.requirements_en).map((r) => <li>{r}</li>)}</ul>
            </details>
            <p class="foot"><span class="doc-no">{j.data.reference} · {dateFmt(j.data.date, lang)}</span>
              <a class="btn" href="#soknad" data-apply={j.data.reference}>{t('Søk på stillingen', 'Apply now')}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band alt" id="soknad">
    <div class="wrap grid c2" style="gap:3rem;align-items:start">
      <div>
        <h2>{t('Send søknad', 'Apply')}</h2>
        <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{t('Fyll ut skjemaet, så kontakter vi deg innen to arbeidsdager. Ta med sertifikatene dine til intervjuet. Før du reiser fra Ågotnes må du ha gyldige sikkerhetskurs og helseattest.', 'Fill in the form and we will contact you within two working days. Bring your certificates to the interview. Before you leave Ågotnes you need valid safety certificates and a medical certificate.')}</p>
        <p class="small muted">{t('Vi leser søknadene fortløpende. Oppstart er 28. oktober 2028.', 'We read applications as they arrive. Start date is 28 October 2028.')}</p>
      </div>
      <div>
        <form data-confirm="apply-done" data-ref-prefix="KV-SØ" data-log="application">
          <div class="field">
            <label for="a-job">{t('Stilling', 'Position')}</label>
            <select id="a-job" required>
              <option value="">{t('Velg stilling', 'Select position')}</option>
              {jobs.map((j) => <option value={j.data.reference}>{lang === 'no' ? j.data.title_no : j.data.title_en} ({j.data.reference})</option>)}
            </select>
          </div>
          <div class="field"><label for="a-name">{t('Navn', 'Name')}</label><input id="a-name" type="text" required autocomplete="name" /></div>
          <div class="field"><label for="a-email">{t('E-postadresse', 'Email address')}</label><input id="a-email" type="email" required autocomplete="email" /></div>
          <div class="field"><label for="a-exp">{t('Erfaring offshore (år, valgfritt)', 'Offshore experience (years, optional)')}</label><input id="a-exp" type="text" /></div>
          <div class="field"><label><input type="checkbox" required data-label="Certificates confirmed" /> {t('Jeg har eller kan få gyldige sikkerhetskurs og helseattest før 28. oktober.', 'I hold, or can obtain, valid safety certificates and a medical certificate before 28 October.')}</label></div>
          <div class="field"><label for="a-msg">{t('Melding (valgfritt)', 'Message (optional)')}</label><textarea id="a-msg" rows="4"></textarea></div>
          <button class="btn" type="submit">{t('Send søknad', 'Send application')}</button>
        </form>
        <div class="confirm" id="apply-done" hidden>
          <h3>{t('Takk for søknaden', 'Thank you for applying')}</h3>
          <p>{t('Søknaden din er mottatt.', 'Your application has been received.')} <span class="doc-no" data-ref></span></p>
          <p class="small muted">{t('Vi tar kontakt innen to arbeidsdager.', 'We will contact you within two working days.')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap grid c2" style="gap:3rem;align-items:center">
      <div>
        <h2>{t('Hvorfor Kelvara', 'Why Kelvara')}</h2>
        <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{t('Hos oss er du med i et lite mannskap der alle teller. Du får ansvar tidlig, du lærer av folk med erfaring, og du blir hørt. Det er kort vei fra beslutning til handling, og ingen er for viktige til å stoppe en jobb som er utrygg.', 'You join a small crew where everyone counts. You get responsibility early, you learn from people with experience, and you are listened to. The path from decision to action is short, and nobody is too important to stop an unsafe job.')}</p>
        <h3 style="margin-top:1.6rem">{t('Slik fungerer rotasjonen', 'How the rotation works')}</h3>
        <p>{t('Til vanlig jobber du to uker offshore og har fire uker fri. Fra 1. november går Ødemark A over til vinterplan, og mannskapet signerer på for hele sesongen frem til våren. Etter sesongen får du lengre sammenhengende fri. Forsyninger og transport går fra Ågotnes. Offshore har du egen lugar, tre måltider om dagen og lege tilgjengelig hele døgnet.', 'Normally you work two weeks offshore and have four weeks off. From 1 November Ødemark A moves to its winter schedule, and the crew sign on for the whole season until spring. After the season you get a longer stretch off. Supplies and transport go from Ågotnes. Offshore you have your own cabin, three meals a day and a medic available around the clock.')}</p>
      </div>
      <Placeholder file="mannskap-odemark-a.jpg" ratio="4 / 3" label={t('Mannskap i oransje kjeledress på Ødemark A', 'Crew in orange overalls on Ødemark A')} />
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2>{t('Møt mannskapet', 'Meet the crew')}</h2>
      <div class="strata" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="grid c3" style="align-items:start">
        {quotes.map((q) => (
          <div class="quote">
            <Placeholder file={`portrett-${slug(q.data.name)}.jpg`} ratio="1 / 1" label={t(`Portrett av ${q.data.name}`, `Portrait of ${q.data.name}`)} class="light" />
            <blockquote style="margin-top:1rem">{lang === "no" ? "«" : "“"}{lang === "no" ? q.data.quote_no : q.data.quote_en}{lang === "no" ? "»" : "”"}</blockquote>
            <div class="who">{q.data.name}</div>
            <div class="role">{lang === 'no' ? q.data.role_no : q.data.role_en}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
