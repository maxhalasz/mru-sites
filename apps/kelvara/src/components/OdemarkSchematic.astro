---
// General arrangement drawing of Ødemark A: elevation, plan view, dimensions, key and title block.
// Not to scale. Depth, topside size and capacity come from the platform facts; the layout is schematic.
import { paths, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const no = lang === 'no';
const t = (a: string, b: string) => (no ? a : b);
const jobsHref = `${paths[lang].careers}#stillinger`;

const key: [number, string][] = [
  [1, t('Helikopterdekk', 'Helideck')],
  [2, t('Boligkvarter (dimensjonert for 196 personer)', 'Living quarters (designed for 196 persons)')],
  [3, t('Prosessmodul', 'Process module')],
  [4, t('Brønnhodemodul og boretårn', 'Wellhead module and derrick')],
  [5, t('Kraner (3)', 'Cranes (3)')],
  [6, t('Fakkelbom', 'Flare boom')],
  [7, t('Kjellerdekk', 'Cellar deck')],
  [8, t('Skaft (3), betong', 'Shafts (3), concrete')],
  [9, t('Lagerceller, gravitasjonsbasert understell', 'Storage cells, gravity base')],
  [10, t('Subsea-ramme og ROV', 'Subsea template and ROV')],
];
const cells = Array.from({ length: 6 }, (_, i) => 165 + i * 70);
const skirts = Array.from({ length: 35 }, (_, i) => 97 + i * 14);
const waves = Array.from({ length: 26 }, (_, i) => 30 + i * 25);
const windows = Array.from({ length: 4 }, (_, r) => Array.from({ length: 5 }, (_, c) => [508 + c * 13, 124 + r * 20]));
const call = (n: number, x: number, y: number) => ({ n, x, y });
const calls = [call(1, 574, 82), call(2, 537, 150), call(3, 340, 188), call(4, 168, 130), call(5, 262, 112), call(6, 70, 128), call(7, 340, 250), call(8, 340, 440), call(9, 340, 556), call(10, 628, 540)];
---
<figure class="schem" style="margin:0">
  <div class="schem-scroll">
    <svg viewBox="0 0 1000 700" role="img" aria-labelledby="odm-t odm-d" style="min-width:780px;width:100%;height:auto;display:block">
      <title id="odm-t">{t('Generelt arrangement, Ødemark A (skjematisk, ikke i målestokk)', 'General arrangement, Ødemark A (schematic, not to scale)')}</title>
      <desc id="odm-d">{t('Snitt og plan av Condeep-plattformen Ødemark A med topside på tre nivåer, tre betongskaft, lagerceller og subsea-ramme. Vanndybde 303 meter, topside 114 × 55 meter.', 'Elevation and plan of the Condeep platform Ødemark A with a three-level topside, three concrete shafts, storage cells and a subsea template. Water depth 303 metres, topside 114 × 55 metres.')}</desc>
      <defs>
        <pattern id="h-conc" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="7" height="7" fill="#d9d7cc" /><line x1="0" y1="0" x2="0" y2="7" stroke="#a7a498" stroke-width="1" /></pattern>
        <pattern id="h-sea" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="7" height="7" fill="#c9c6b8" /><line x1="0" y1="0" x2="0" y2="7" stroke="#6d6a60" stroke-width="1.2" /></pattern>
        <pattern id="h-lq" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)"><rect width="6" height="6" fill="#fff" /><line x1="0" y1="0" x2="0" y2="6" stroke="#161616" stroke-width=".9" /></pattern>
        <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#161616" /></marker>
      </defs>

      <!-- sheet frame -->
      <rect x="8" y="8" width="984" height="684" fill="#fff" stroke="#161616" stroke-width="2" />
      <rect x="14" y="14" width="972" height="672" fill="none" stroke="#161616" stroke-width=".8" />
      <g font-family="Arial, Helvetica, sans-serif" fill="#161616">

        <!-- water and seabed -->
        <rect x="28" y="330" width="640" height="268" fill="#e8eff1" />
        <path d={`M28 330 ${waves.map(() => 'q6 -6 12.5 0 t12.5 0').join(' ')}`} fill="none" stroke="#161616" stroke-width="1.2" />
        <text x="34" y="324" font-size="11" fill="#55555a">{t('Havflate (MSL)', 'Sea level (MSL)')}</text>
        <rect x="28" y="598" width="640" height="11" fill="url(#h-sea)" stroke="#161616" stroke-width="1.4" />
        <text x="34" y="624" font-size="11" fill="#55555a">{t('Havbunn', 'Seabed')}</text>

        <!-- caisson: storage cells -->
        <rect x="95" y="520" width="490" height="68" fill="url(#h-conc)" stroke="#161616" stroke-width="1.6" />
        {cells.map((x) => <line x1={x} y1="520" x2={x} y2="588" stroke="#161616" stroke-width="1.2" />)}
        {[130, 200, 270, 340, 410, 480, 550].map((x) => <path d={`M${x - 24} 520 q24 -16 48 0`} fill="#d9d7cc" stroke="#161616" stroke-width="1.2" />)}
        <path d="M95 588 H585 V598 H95 z" fill="#fff" stroke="#161616" stroke-width="1.2" />
        {skirts.map((x) => <line x1={x} y1="588" x2={x} y2="598" stroke="#161616" stroke-width="1.2" />)}

        <!-- shafts with break marks -->
        {[170, 340, 510].map((cx) => (
          <g>
            <rect x={cx - 27} y="270" width="54" height="250" fill="url(#h-conc)" stroke="#161616" stroke-width="1.6" />
            <rect x={cx - 27.8} y="396" width="55.6" height="22" fill="#e8eff1" />
            <path d={`M${cx - 28} 396 l9 5 l9 -5 l9 5 l9 -5 l9 5 l9 -5 M${cx - 28} 418 l9 -5 l9 5 l9 -5 l9 5 l9 -5 l9 5`} fill="none" stroke="#161616" stroke-width="1.2" />
          </g>
        ))}
        <text x="396" y="412" font-size="10" fill="#55555a">{t('Skaft forkortet i tegningen', 'Shafts shortened in drawing')}</text>

        <!-- topside: cellar deck -->
        <rect x="100" y="262" width="480" height="8" fill="#161616" />
        <g fill="#f5f4ee" stroke="#161616" stroke-width="1.2">
          <rect x="108" y="226" width="64" height="36" /><rect x="178" y="236" width="52" height="26" /><rect x="236" y="228" width="70" height="34" />
          <rect x="312" y="238" width="58" height="24" /><rect x="376" y="230" width="66" height="32" /><rect x="448" y="236" width="60" height="26" />
          <rect x="514" y="232" width="58" height="30" />
        </g>
        <g stroke="#161616" stroke-width="1">
          <line x1="120" y1="236" x2="160" y2="236" /><line x1="190" y1="246" x2="218" y2="246" /><line x1="248" y1="238" x2="294" y2="238" />
          <line x1="324" y1="248" x2="358" y2="248" /><line x1="388" y1="240" x2="430" y2="240" /><line x1="460" y1="246" x2="496" y2="246" />
        </g>

        <!-- main deck -->
        <rect x="110" y="212" width="460" height="8" fill="#161616" />
        <!-- wellhead module + drill floor (highlighted: Driller, Roughneck) -->
        <rect x="124" y="172" width="104" height="40" fill="#fff" stroke="#d9531e" stroke-width="2.2" />
        <path d="M150 172 L164 76 L184 76 L198 172" fill="none" stroke="#d9531e" stroke-width="2" />
        <path d="M156 140 L192 140 M159 112 L189 112 M162 92 L186 92 M152 160 L196 160" stroke="#d9531e" stroke-width="1.2" />
        <path d="M150 172 L196 140 M198 172 L156 140 M156 140 L189 112 M192 140 L162 112 M162 112 L186 92 M189 112 L164 92" stroke="#d9531e" stroke-width=".9" fill="none" />
        <rect x="160" y="70" width="28" height="7" fill="#d9531e" />
        <rect x="132" y="190" width="88" height="22" fill="#fff" stroke="#161616" stroke-width="1.2" />
        <!-- process module -->
        <rect x="236" y="176" width="204" height="36" fill="#fff" stroke="#161616" stroke-width="1.6" />
        <g fill="#f5f4ee" stroke="#161616" stroke-width="1.1"><rect x="244" y="184" width="40" height="28" /><rect x="292" y="182" width="52" height="30" /><rect x="352" y="186" width="36" height="26" /><rect x="394" y="180" width="38" height="32" /></g>
        <!-- utilities -->
        <rect x="444" y="186" width="52" height="26" fill="#f5f4ee" stroke="#161616" stroke-width="1.2" />
        <!-- upper deck -->
        <rect x="232" y="166" width="268" height="7" fill="#161616" />
        <g fill="#f5f4ee" stroke="#161616" stroke-width="1.2"><rect x="250" y="146" width="62" height="20" /><rect x="324" y="150" width="50" height="16" /><rect x="386" y="144" width="70" height="22" /></g>
        <!-- living quarters + helideck -->
        <rect x="500" y="112" width="76" height="100" fill="url(#h-lq)" stroke="#161616" stroke-width="1.6" />
        {windows.map((row) => row.map(([x, y]) => <rect x={x} y={y} width="8" height="9" fill="#fff" stroke="#161616" stroke-width=".8" />))}
        <path d="M512 112 V102 M564 112 V102" stroke="#161616" stroke-width="2" />
        <rect x="486" y="94" width="108" height="8" fill="#161616" />
        <circle cx="540" cy="90" r="0" />
        <text x="533" y="90" font-size="10" font-weight="700" fill="#161616">H</text>
        <path d="M578 222 l9 0 l0 9 l-9 0 z M590 222 l9 0 l0 9 l-9 0 z" fill="#fff" stroke="#161616" stroke-width="1" />
        <!-- cranes -->
        <g stroke="#161616" stroke-width="2.4" fill="none">
          <path d="M262 146 V122 L214 96" /><path d="M214 96 V110" stroke-width="1" />
          <path d="M380 150 V126 L430 100" /><path d="M430 100 V116" stroke-width="1" />
          <path d="M470 144 V120 L420 94" /><path d="M420 94 V108" stroke-width="1" />
        </g>
        <g fill="#161616"><circle cx="262" cy="146" r="4" /><circle cx="380" cy="150" r="4" /><circle cx="470" cy="144" r="4" /></g>
        <!-- flare boom -->
        <path d="M112 212 L52 112 M122 212 L66 118" stroke="#161616" stroke-width="2" fill="none" />
        <path d="M52 112 q-6 -14 3 -26 q2 10 8 14 q4 -6 1 -14 q12 10 3 26 z" fill="#d9531e" stroke="#161616" stroke-width="1" />

        <!-- subsea: template, flowline, ROV (highlighted: Subsea Operator) -->
        <path d="M585 590 H612" stroke="#161616" stroke-width="3" />
        <rect x="612" y="574" width="46" height="24" fill="#fff" stroke="#d9531e" stroke-width="2.2" />
        <path d="M620 574 V556 M635 574 V552 M650 574 V556" stroke="#d9531e" stroke-width="2.2" />
        <path d="M616 556 h8 M631 552 h8 M646 556 h8" stroke="#d9531e" stroke-width="2.2" />
        <g transform="translate(622 470)">
          <rect x="0" y="0" width="34" height="18" rx="3" fill="#fff" stroke="#d9531e" stroke-width="2" />
          <circle cx="8" cy="9" r="3" fill="#d9531e" /><circle cx="26" cy="9" r="3" fill="#d9531e" />
          <path d="M-8 20 h50" stroke="#d9531e" stroke-width="2" />
        </g>
        <path d="M639 470 C639 420 600 330 580 270" fill="none" stroke="#55555a" stroke-width="1" stroke-dasharray="5 4" />
        <text x="600" y="444" font-size="10" fill="#55555a">{t('Umbilikal', 'Tether')}</text>

        <!-- dimensions -->
        <g stroke="#161616" stroke-width="1" fill="none">
          <path d="M100 44 H580" marker-start="url(#arr)" marker-end="url(#arr)" />
          <path d="M100 38 V270 M580 38 V262" stroke-dasharray="2 3" stroke="#55555a" />
          <path d="M60 330 V448 M60 464 V598" marker-start="url(#arr)" />
          <path d="M60 598 V464" marker-end="url(#arr)" />
          <path d="M60 330 V448" marker-start="none" />
          <path d="M54 452 l12 -6 M54 462 l12 -6" stroke-width="1.4" />
          <path d="M40 330 H80 M40 598 H80" stroke-dasharray="2 3" stroke="#55555a" />
        </g>
        <path d="M60 330 V446" stroke="#161616" stroke-width="1" marker-start="url(#arr)" />
        <rect x="260" y="36" width="80" height="16" fill="#fff" />
        <text x="300" y="49" font-size="13" font-weight="700" text-anchor="middle">114 m</text>
        <text transform="translate(48 470) rotate(-90)" font-size="13" font-weight="700" text-anchor="middle">303 m</text>

        <!-- deck level labels -->
        <g font-size="10.5" fill="#161616">
          <path d="M500 169 H606 M572 216 H606 M580 266 H606" stroke="#161616" stroke-width=".8" />
          <text x="610" y="172">{t('ØVRE DEKK', 'UPPER DECK')}</text>
          <text x="610" y="219">{t('HOVEDDEKK', 'MAIN DECK')}</text>
          <text x="610" y="269">{t('KJELLERDEKK', 'CELLAR DECK')}</text>
        </g>
        <text x="610" y="190" font-size="10" fill="#55555a">{t('Topside, tre nivåer', 'Topside, three levels')}</text>

        <!-- callout numbers -->
        {calls.map((c) => (
          <g>
            <circle cx={c.x} cy={c.y} r="10" fill="#161616" />
            <text x={c.x} y={c.y + 4} font-size="11" font-weight="700" fill="#fff" text-anchor="middle">{c.n}</text>
          </g>
        ))}

        <!-- plan view -->
        <text x="690" y="26" font-size="11" font-weight="700">{t('PLAN, TOPSIDE', 'PLAN, TOPSIDE')}</text>
        <rect x="708" y="34" width="250" height="121" fill="#fff" stroke="#161616" stroke-width="1.6" />
        {[748, 833, 918].map((x) => <circle cx={x} cy="95" r="19" fill="url(#h-conc)" stroke="#161616" stroke-width="1.3" />)}
        <rect x="868" y="40" width="84" height="109" fill="url(#h-lq)" stroke="#161616" stroke-width="1.2" />
        <circle cx="910" cy="94" r="24" fill="#fff" stroke="#161616" stroke-width="1.4" />
        <text x="905" y="99" font-size="14" font-weight="700">H</text>
        <rect x="716" y="44" width="40" height="30" fill="#fff" stroke="#d9531e" stroke-width="2" />
        <rect x="788" y="46" width="64" height="40" fill="#fff" stroke="#161616" stroke-width="1" />
        <rect x="788" y="104" width="64" height="40" fill="#fff" stroke="#161616" stroke-width="1" />
        <path d="M708 166 H958" stroke="#161616" stroke-width="1" marker-start="url(#arr)" marker-end="url(#arr)" />
        <text x="833" y="178" font-size="11" font-weight="700" text-anchor="middle">114 m</text>
        <path d="M970 34 V155" stroke="#161616" stroke-width="1" marker-start="url(#arr)" marker-end="url(#arr)" />
        <text transform="translate(982 98) rotate(-90)" font-size="11" font-weight="700" text-anchor="middle">55 m</text>

        <!-- key -->
        <text x="690" y="212" font-size="11" font-weight="700">{t('FORKLARING', 'KEY')}</text>
        <line x1="690" y1="217" x2="974" y2="217" stroke="#161616" stroke-width="1.2" />
        {key.map(([n, label], i) => (
          <g>
            <circle cx="702" cy={235 + i * 22} r="8.5" fill="#161616" />
            <text x="702" y={239 + i * 22} font-size="10" font-weight="700" fill="#fff" text-anchor="middle">{n}</text>
            <text x="718" y={239 + i * 22} font-size="11.5">{label}</text>
          </g>
        ))}

        <!-- vacancies box -->
        <a href={jobsHref}>
          <rect x="690" y="470" width="284" height="116" fill="#fff" stroke="#d9531e" stroke-width="2.2" />
          <rect x="690" y="470" width="284" height="22" fill="#d9531e" />
          <text x="700" y="485" font-size="11" font-weight="700" fill="#fff">{t('LEDIGE STILLINGER PÅ ANLEGGET', 'VACANCIES ON THIS INSTALLATION')}</text>
          <text x="700" y="512" font-size="12" font-weight="700">Driller</text><text x="780" y="512" font-size="11.5">{t('boredekk (4)', 'drill floor (4)')}</text>
          <text x="700" y="534" font-size="12" font-weight="700">Roughneck</text><text x="780" y="534" font-size="11.5">{t('boredekk og rørdekk (4)', 'drill floor and pipe deck (4)')}</text>
          <text x="700" y="556" font-size="12" font-weight="700">Subsea Operator</text><text x="810" y="556" font-size="11.5">{t('subsea (10)', 'subsea (10)')}</text>
          <text x="700" y="577" font-size="11" fill="#a53a10" text-decoration="underline">{t('Se stillingene og søk →', 'See the positions and apply →')}</text>
        </a>

        <!-- title block -->
        <rect x="690" y="598" width="284" height="80" fill="#fff" stroke="#161616" stroke-width="1.6" />
        <line x1="690" y1="620" x2="974" y2="620" stroke="#161616" stroke-width="1" />
        <line x1="690" y1="650" x2="974" y2="650" stroke="#161616" stroke-width="1" />
        <line x1="860" y1="650" x2="860" y2="678" stroke="#161616" stroke-width="1" />
        <text x="700" y="614" font-size="12" font-weight="700">ØDEMARK A · KELVARA PETROCHEMICALS AS</text>
        <text x="700" y="639" font-size="11.5">{t('Generelt arrangement, skjematisk snitt og plan', 'General arrangement, schematic elevation and plan')}</text>
        <text x="700" y="668" font-size="10.5" fill="#55555a">{t('Ikke i målestokk', 'Not to scale')}</text>
        <text x="870" y="668" font-size="10.5" fill="#55555a">KV-ODM-GA-001 · REV. 3</text>
      </g>
    </svg>
  </div>
  <figcaption class="small muted" style="margin-top:.6rem">{t('Skjematisk tegning, ikke i målestokk. Vanndybde 303 m, topside 114 × 55 m.', 'Schematic drawing, not to scale. Water depth 303 m, topside 114 × 55 m.')}</figcaption>
</figure>
