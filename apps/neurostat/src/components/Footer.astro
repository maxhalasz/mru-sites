  <div class="wrap">
    <div class="cols">
      <div>
        <img src="/img/neurostat-logo-light.svg" alt="NeuroStat" width="64" height="70" style="height:70px;width:auto;margin-bottom:1rem" />
        <p>NeuroStat Holding AG<br />Thurgauerstrasse 66<br />8050 Zürich, Switzerland</p>
        <p class="small">SIX Swiss Exchange: NEUS</p>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About NeuroStat</a></li>
          <li><a href="/about/leadership/">Leadership</a></li>
          <li><a href="/about/governance/">Governance</a></li>
          <li><a href="/careers/">Careers</a></li>
        </ul>
      </div>
      <div>
        <h4>Science and products</h4>
        <ul>
          <li><a href="/science/">Science</a></li>
          <li><a href="/products/">Products</a></li>
          <li><a href="/pipeline/">Pipeline</a></li>
          <li><a href="/clinical-trials/">Clinical trials</a></li>
        </ul>
      </div>
      <div>
        <h4>Investors and media</h4>
        <ul>
          <li><a href="/investors/">Investors</a></li>
