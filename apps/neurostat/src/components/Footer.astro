        <li><a href="/terms/">Terms of use</a></li>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
        <li><a href="#cookie-settings" id="cookie-settings">Cookie settings</a></li>
      </ul>
      <div class="partner"><a href="/partner/">Partner Access</a></div>
    </div>
  </div>
