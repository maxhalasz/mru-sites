<div class="cookie" id="cookie-banner" role="region" aria-label="Cookie notice" hidden>
  <div class="wrap">
    <p>
      We use essential cookies to make this website work. With your consent we would also use optional
      cookies to understand how the site is used. You can change your choice at any time in the{' '}
      <a href="/privacy/#cookies">privacy policy</a>.
    </p>
    <div class="actions">
      <button class="btn ghost" type="button" data-consent="essential">Essential only</button>
      <button class="btn" type="button" data-consent="all">Accept all</button>
    </div>
  </div>
</div>
<script is:inline src="/js/cookie-banner.js"></script>
