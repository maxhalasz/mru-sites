---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" current="" description="Contact NeuroStat.">
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> / Contact</div>
      <h1>Contact</h1>
      <p>For medical questions, press, investors or general enquiries.</p>
    </div>
  </div>
  <section class="band">
    <div class="wrap grid c2" style="gap:3rem;align-items:start">
      <div>
        <h2>Send an enquiry</h2>
        <form data-confirm="contact-done" data-ref-prefix="NS-CQ">
          <div class="field"><label for="c-name">Name</label><input id="c-name" type="text" required autocomplete="name" /></div>
          <div class="field"><label for="c-email">Email address</label><input id="c-email" type="email" required autocomplete="email" /></div>
          <div class="field">
            <label for="c-topic">Topic</label>
            <select id="c-topic" required>
              <option value="">Select</option>
              <option>Medical information</option>
              <option>Report a side effect</option>
              <option>Press</option>
              <option>Investor relations</option>
              <option>Clinical trials</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" rows="6" required></textarea></div>
          <p class="small muted">Please do not include health information unless you are reporting a side effect. See our <a href="/privacy/">privacy policy</a>.</p>
          <button class="btn" type="submit">Send</button>
        </form>
        <div class="confirm" id="contact-done" hidden>
          <h3>Thank you</h3>
          <p>Your enquiry <span data-ref></span> has been received.</p>
          <p class="small muted">We aim to respond within five working days.</p>
        </div>
      </div>
      <div>
        <h2>Offices</h2>
        <p><b>Zürich (headquarters)</b><br />NeuroStat Holding AG<br />Thurgauerstrasse 66<br />8050 Zürich, Switzerland<br />+41 00 000 00 00</p>
        <p><b>Basel</b>, Switzerland<br /><b>Boston</b>, United States<br /><b>London</b>, United Kingdom</p>
        <h2 style="margin-top:2rem">Direct contacts</h2>
        <p>Medical information: <a href="mailto:medinfo@neurostat.example">medinfo@neurostat.example</a><br />
        Investor relations: <a href="mailto:ir@neurostat.example">ir@neurostat.example</a><br />
        Press: <a href="mailto:press@neurostat.example">press@neurostat.example</a></p>
      </div>
    </div>
  </section>
</Base>
