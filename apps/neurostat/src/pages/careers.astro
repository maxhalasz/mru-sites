---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import ExtLink from '../components/ExtLink.astro';
import { published, shortDate, isoDay } from '../data/util';
const jobs = (await published('jobs')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Careers" current="/careers/" description="Work at NeuroStat: open positions in Zürich and field positions with our partners.">
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> / Careers</div>
      <h1>Careers</h1>
      <p>Positions in Zürich, and field positions with our partners.</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap grid c2" style="gap:3rem;align-items:center">
      <div class="prose">
        <h2>Life at NeuroStat</h2>
        <p>About 1,100 of us work in Zürich, Basel, Boston and London: clinicians, neuroscientists, statisticians, engineers and regulatory specialists. We work in small groups, read each other's work openly and make a point of meeting the people who use what we build.</p>
        <p>Benefits include flexible hours, a research sabbatical after five years and a budget for further education.</p>
      </div>
      <Placeholder file="careers-team.jpg" ratio="4 / 3" label="Researchers at work in a laboratory" />
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2>Open positions in Zürich</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Position</th><th>Team</th><th>Location</th><th>Posted</th></tr></thead>
          <tbody>
            {jobs.map((j) => (
              <tr data-date={isoDay(j.data.date)}>
                <td><b>{j.data.title}</b><br /><span class="doc-no">{j.data.reference}</span></td>
                <td>{j.data.team}</td>
                <td>{j.data.location}</td>
                <td>{shortDate(j.data.date)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:1rem">Applications go through our recruitment portal, which is closed for these positions while the current round is under way. Check again in the new year.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap prose">
      <h2>Placements with partner companies</h2>
      <p>After two years with us you can apply for a placement of three to twelve months at one of our partner companies. Current placement partners are Roche and Novartis in Basel, Lundbeck in Copenhagen, Biogen in Cambridge, Massachusetts, and AstraZeneca in Cambridge, United Kingdom. Your manager and the partner's own HR team arrange the details with you, and your employment with NeuroStat continues during the placement.</p>
      <p>Partners also send researchers to us. Some of the people you meet in Zürich and Basel are guests from these companies.</p>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap prose">
      <h2>Field positions with our partners</h2>
      <p>NeuroStat works with partner companies that offer field positions in demanding environments, including offshore work in the Norwegian North Sea.</p>
      <p><b>Ødemark A, Norwegian North Sea — Kelvara Petrochemicals AS.</b> Most positions for the 2028/29 winter rotation have been filled. Current openings are listed on <ExtLink href="https://kelvarapetro.github.io/en/careers/">Kelvara's careers page</ExtLink>.</p>
      <p>Security and logistics positions are advertised separately by <ExtLink href="http://aegiscorp.net">Aegis Corporation</ExtLink>, polar station positions by <ExtLink href="http://hiemalpolar.com">Hiemal Polar Services</ExtLink> and desert site positions by <ExtLink href="http://eremosdesert.com">Eremos Desert Operations</ExtLink>.</p>
    </div>
  </section>
</Base>
