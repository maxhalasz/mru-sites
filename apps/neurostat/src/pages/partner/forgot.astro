---
import Base from '../../layouts/Base.astro';
---
<Base title="Forgot password" noindex search={false}>
  <section class="band" style="padding-top:2.5rem">
    <div class="wrap">
      <div class="login-box">
        <p class="eyebrow">NeuroStat Org.</p>
        <h1 style="font-size:1.9rem">Forgot password?</h1>
        <p>Passwords for Partner Access cannot be reset on this page. Password changes are handled by the IT Service Desk.</p>
        <p>Contact the IT Service Desk at <a href="mailto:servicedesk@neurostat.ch">servicedesk@neurostat.ch</a> and quote your username and the name of your organisation. Requests are processed on working days.</p>
        <p><a class="btn ghost" href="/partner/">Back to sign in</a></p>
      </div>
    </div>
  </section>
</Base>
