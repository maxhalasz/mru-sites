---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex search={false}>
  <section class="band">
    <div class="wrap prose" style="padding:3rem 0">
      <p class="eyebrow">Error 404</p>
      <h1>This page could not be found</h1>
      <p>The address may have changed, or the page may no longer be available.</p>
      <p><a class="btn" href="/">Go to the home page</a> <a class="btn ghost" href="/search/">Search</a></p>
    </div>
  </section>
</Base>
