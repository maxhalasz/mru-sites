---
import Base from '../../layouts/Base.astro';
import { published } from '../../data/util';
const products = (await published('products')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Products" current="/products/" description="NeuroStat medicines, devices and digital platforms.">
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> / Products</div>
      <h1>Products</h1>
      <p>Two medicines for sleep, one for migraine, a medical device, a digital platform and an imaging system.</p>
    </div>
  </div>
  <section class="band">
    <div class="wrap">
      <div class="grid c3">
        {products.map((p) => (
          <a class="card" href={`/products/${p.id}/`} style="text-decoration:none;color:inherit" data-date={`${p.data.approved}-01-01`}>
            <span class="tag" style="align-self:flex-start">{p.data.kind}</span>
            <h3 style="margin-top:.8rem">{p.data.name}</h3>
            <p class="muted small" style="margin-bottom:.6rem">{p.data.generic}</p>
            <p>{p.data.tagline}</p>
            <span class="more">Details</span>
          </a>
        ))}
      </div>
      <p class="form-note small" style="margin-top:2rem">Availability and approved uses differ between countries. This website is written for a global audience and is no substitute for advice from a healthcare professional. Read the package leaflet before use.</p>
    </div>
  </section>
</Base>
