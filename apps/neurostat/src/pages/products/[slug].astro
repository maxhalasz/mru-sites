---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { published } from '../../data/util';

export async function getStaticPaths() {
  const products = await published('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const isMedicine = d.kind === 'Medicine';
---
<Base title={d.name} current="/products/" description={d.tagline}>
  <div data-gate={`${d.approved}-01-01`}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> / <a href="/products/">Products</a> / {d.name}</div>
      <span class="tag">{d.kind}</span>
      <h1 style="margin-top:.6rem">{d.name}</h1>
      <p>{d.tagline}</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap grid c2" style="gap:3rem;align-items:start">
      <div class="prose">
        <h2>What it is</h2>
        <table>
          <tbody>
            <tr><th scope="row">{isMedicine ? 'Active substance' : 'Type'}</th><td>{d.generic}</td></tr>
            <tr><th scope="row">{isMedicine ? 'Class' : 'Category'}</th><td>{d.drugClass}</td></tr>
            <tr><th scope="row">Indication</th><td>{d.indication}</td></tr>
            <tr><th scope="row">{isMedicine ? 'First approved' : 'Launched'}</th><td>{d.approved}</td></tr>
          </tbody>
        </table>

        <h2>How it works</h2>
        <p>{d.how}</p>

        <h2>Important safety information</h2>
        <ul>{d.safety.map((s) => <li>{s}</li>)}</ul>
        <p class="small muted">This is a summary. It does not list every risk. Read the {isMedicine ? 'package leaflet' : 'instructions for use'} before use and ask a healthcare professional if you have questions.</p>
        <p>
          {d.leaflet
            ? <a class="btn ghost" href={d.leaflet}>{isMedicine ? 'Package leaflet (PDF)' : 'Instructions for use (PDF)'}</a>
            : <a class="btn ghost" href={`/docs/${p.id}-leaflet.pdf`}>{isMedicine ? 'Package leaflet (PDF)' : 'Instructions for use (PDF)'}</a>}
        </p>
      </div>
      <Placeholder file={`product-${p.id}.jpg`} ratio="4 / 5" label={`Product image: ${d.name}`} />
    </div>
  </section>

  <section class="band alt">
    <div class="wrap prose">
      <h2>Clinical information</h2>
      <div data-hcp-gate>
        <div class="form-note">
          <p><b>Are you a healthcare professional?</b></p>
          <p>The clinical information below is intended for healthcare professionals.</p>
          <p style="margin:0"><button type="button" class="btn" data-hcp-yes>Yes, I am a healthcare professional</button> <a class="btn ghost" href="/products/">No</a></p>
        </div>
      </div>
      <div data-hcp-content hidden>
        <ul>{d.clinical.map((s) => <li>{s}</li>)}</ul>
        <p class="small muted">Suspected adverse reactions should be reported to the national authority. You can also contact <a href="/contact/">NeuroStat medical information</a>.</p>
      </div>
      <noscript><p class="muted small">Enable JavaScript to confirm you are a healthcare professional and view this section.</p></noscript>
    </div>
  </section>
  </div>
</Base>
