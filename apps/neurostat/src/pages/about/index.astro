---
import Base from '../../layouts/Base.astro';
import ExtLink from '../../components/ExtLink.astro';

const timeline = [
  ['2003', 'NeuroStat is founded in Zürich by Dr. Adriond Fisher together with a group of clinicians.'],
  ['2006', 'Vesperil (ormelteon) is approved, the first NeuroStat product.'],
  ['2008', 'Clinical research site opens in Basel.'],
  ['2010', 'NeuroStat lists on the SIX Swiss Exchange under the ticker NEUS.'],
  ['2014', 'Office opens in Boston for regulatory and clinical collaboration in North America.'],
  ['2015', 'NeuroStat Baseline, a digital cognitive assessment platform, is launched.'],
  ['2017', 'Lunavel (corexant) is approved for insomnia.'],
  ['2018', 'Office opens in London.'],
  ['2019', 'NeuroStat Halo, a dry-electrode EEG headband, receives CE marking.'],
  ['2020', 'Migrestil (tolugepant) is approved for the acute treatment of migraine.'],
  ['2026', 'A Phase III study of tolugepant in migraine prevention does not meet its primary endpoint.'],
  ['2028', 'BOREAS-2, a Phase II study of NS-760 in extended offshore rotations, begins recruitment.'],
];
const locations = [
  ['Zürich', 'Headquarters, research and corporate functions'],
  ['Basel', 'Clinical research'],
  ['Boston', 'Regulatory and clinical collaboration, North America'],
  ['London', 'Medical affairs and commercial, United Kingdom and Ireland'],
];
---
<Base title="About" current="/about/">
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> / About</div>
      <h1>About NeuroStat</h1>
      <p>A biopharmaceutical company founded in Zürich in 2003, working on sleep, memory and cognition.</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap prose">
      <h2>Who we are</h2>
      <p>NeuroStat develops treatments and diagnostic tools for conditions of the nervous system. Our first products addressed sleep. Today we also work on memory and on how people perform under strain, and we run studies with partners whose work puts the brain under unusual load.</p>
      <p>We are listed on the SIX Swiss Exchange (NEUS). Our headquarters are in Zürich, and we have offices in Basel, Boston and London.</p>
      <p><a href="/about/leadership/">Leadership</a> · <a href="/about/governance/">Governance</a></p>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2>Our history</h2>
      <ul class="timeline">
        {timeline.map(([y, t]) => <li><span class="yr">{y}</span>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Group companies</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Company</th><th>Business</th></tr></thead>
          <tbody>
            <tr><td>NeuroStat Diagnostics AG, Basel</td><td>Development and operation of Baseline and Halo</td></tr>
            <tr><td>NeuroStat Clinical Services GmbH, Zürich</td><td>Clinical study operations and site support</td></tr>
            <tr><td><ExtLink href="http://aegiscorp.net">Aegis Corporation</ExtLink></td><td>Security and logistics services</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2>Locations</h2>
      <div class="grid c4">
        {locations.map(([c, d]) => <div class="card"><h3>{c}</h3><p class="muted">{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap prose">
      <h2>Responsibility</h2>
      <p>We run our studies to international good clinical practice standards and publish the results, whatever they show. We assess the safety of every programme before it reaches patients and keep monitoring it afterwards.</p>
      <p>We expect the same of our suppliers and partners. Our supplier code of conduct covers labour conditions, safety and the environment.</p>
      <p>We are working to cut emissions from our laboratories and offices, and we report on progress in our annual report.</p>
    </div>
  </section>
</Base>
