---
import Base from '../../layouts/Base.astro';
import { published } from '../../data/util';
const trials = (await published('trials')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Clinical Trials" current="/clinical-trials/" description="NeuroStat clinical studies and our policy on study transparency.">
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> / Clinical Trials</div>
      <h1>Clinical Trials</h1>
      <p>Studies sponsored by NeuroStat that are recruiting or under way.</p>
    </div>
  </div>
  <section class="band">
    <div class="wrap">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Study</th><th>Phase</th><th>Status</th><th>Details</th></tr></thead>
          <tbody>
            {trials.map((t) => (
              <tr>
                <td><span class="doc-no">{t.data.id}</span><br /><b>{t.data.title}</b></td>
                <td>{t.data.phase}</td>
                <td>{t.data.status}</td>
                <td><a href={`/clinical-trials/${t.id}/`}>View</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="band alt" id="transparency">
    <div class="wrap prose">
      <h2>Our policy on study transparency</h2>
      <p>We register every interventional study in a public registry before the first participant is enrolled. Results are published within twelve months of a study ending, positive or not, and summary results go to participants and the authorities as required.</p>
      <p>Researchers can ask for anonymised participant-level data from completed studies through our medical information service. An independent panel reviews each request.</p>
      <p>We cannot give medical advice or enrol people directly. If you want to take part in a study, ask your doctor.</p>
    </div>
  </section>
</Base>
