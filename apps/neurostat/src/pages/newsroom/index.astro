---
import Base from '../../layouts/Base.astro';
import { published, longDate } from '../../data/util';
const news = (await published('news')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Newsroom" current="/newsroom/" description="NeuroStat press releases, media library and press contact.">
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> / Newsroom</div>
      <h1>Newsroom</h1>
      <p>Press releases, media resources and contacts for journalists.</p>
    </div>
  </div>
  <Fragment set:html={`<!-- TODO (jb): press archive still runs on Meridian. Move releases from before 2024 to the new CMS, then redirect the old /meridian/ links. Ticket NS-WEB-1184. -->`} />
  <section class="band">
    <div class="wrap grid c2" style="gap:3rem;align-items:start">
      <div>
        <h2>Press releases</h2>
        <ul class="list-plain">
          {news.map((n) => (
            <li>
              <span class="tag">{n.data.category}</span> <span class="muted small">{longDate(n.data.date)}</span>
              <h3 style="margin:.5rem 0 .2rem"><a href={`/newsroom/${n.id}/`} style="text-decoration:none">{n.data.title}</a></h3>
              <p class="muted" style="margin:0">{n.data.summary}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Media library</h2>
        <p>Company logos, executive portraits and product images are available to accredited journalists on request.</p>
        <h2 style="margin-top:2rem">Press contact</h2>
        <p>Corporate Communications<br />NeuroStat Holding AG<br />Thurgauerstrasse 66, 8050 Zürich<br /><a href="mailto:press@neurostat.example">press@neurostat.example</a><br />+41 00 000 00 00</p>
        <h2 style="margin-top:2rem">Newsletter</h2>
        <form data-confirm="news-done" data-ref-prefix="NS-NL">
          <div class="field"><label for="nl-email">Email address</label><input id="nl-email" type="email" required autocomplete="email" /></div>
          <div class="field"><label><input type="checkbox" required /> I agree to receive the NeuroStat newsletter and accept the <a href="/privacy/">privacy policy</a>.</label></div>
          <button class="btn" type="submit">Subscribe</button>
        </form>
        <div class="confirm" id="news-done" hidden><p>Thank you. Your subscription request has been received.</p><p class="doc-no">Reference <span data-ref></span></p></div>
      </div>
    </div>
  </section>
</Base>
