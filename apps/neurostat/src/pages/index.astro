---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import HeroArt from '../components/HeroArt.astro';
import ExtLink from '../components/ExtLink.astro';
import { published, longDate, isFuture, isoDay } from '../data/util';
import { last, change, changePct } from '../data/stock';

const news = (await published('news')).sort((a, b) => +b.data.date - +a.data.date);
const newsShown = news.filter((n) => !isFuture(n.data.date)).slice(0, 3).map((n) => n.id);
const pipeline = await published('pipeline');
const active = pipeline.filter((p) => p.data.phase !== 'Discontinued');
const count = (ph: string) => active.filter((p) => p.data.phase === ph).length;
const areas = [
  ['Sleep & Circadian Health', 'Medicines for insomnia, and for people whose body clock no longer fits their working hours.', '/science/#sleep'],
  ['Memory & Cognition', 'How memories are stored, lost and found again, and how attention holds up after weeks of bad sleep.', '/science/#memory'],
  ['Neurodiagnostics', 'Wearable and digital tools that measure sleep and alertness at the workplace, not in a laboratory.', '/science/#neurodiagnostics'],
];
const up = change >= 0;
---
<Base title="NeuroStat" current="/">
  <section class="hero">
    <HeroArt />
    <div class="wrap">
      <p class="eyebrow" style="color:#9fb2c8">NeuroStat Holding AG</p>
      <h1>Our hope lies in the questions neuroscience has not yet answered.</h1>
      <p>We develop medicines and monitoring tools for sleep, memory and cognition. Many of our studies take place where staying well is hardest, on offshore installations and on night shifts.</p>
      <p><a class="btn" href="/science/" style="background:#fff;color:#14243a">Our science</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Therapeutic areas</p>
      <h2>Where we work</h2>
      <div class="grid c3" style="margin-top:1.5rem">
        {areas.map(([t, d, h]) => (
          <a class="card" href={h} style="text-decoration:none;color:inherit">
            <h3>{t}</h3>
            <p class="muted">{d}</p>
            <span class="more">Read more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap grid c2" style="align-items:center;gap:3rem">
      <Placeholder file="home-extreme-environment.jpg" ratio="4 / 3" label="A consultation room" />
      <div>
        <p class="eyebrow">Medicine at the edge</p>
        <h2>Medicine far from a hospital</h2>
        <p>On polar stations, offshore installations and military bases people work long rotations in the cold and dark, a long way from the nearest hospital. Baseline and Halo let the occupational physician see how a crew is sleeping and thinking before something goes wrong.</p>
        <p>Since 2027 we have worked with the crew of Ødemark A, an installation in the northern North Sea operated by <ExtLink href="https://kelvarapetro.github.io/en/operations/">Kelvara Petrochemicals AS</ExtLink>, on how long winter rotations affect sleep and cognition.</p>
        <p><a href="/products/baseline/">About NeuroStat Baseline</a></p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem">
        <div><p class="eyebrow">Newsroom</p><h2>Latest news</h2></div>
        <a href="/newsroom/">All news</a>
      </div>
      <div class="grid c3" data-limit="3">
        {news.map((n) => (
          <a class="card" href={`/newsroom/${n.id}/`} style="text-decoration:none;color:inherit" data-date={isoDay(n.data.date)} hidden={!newsShown.includes(n.id)}>
            <span class="tag" style="align-self:flex-start">{n.data.category}</span>
            <h3 style="margin-top:.8rem">{n.data.title}</h3>
            <p class="muted small">{longDate(n.data.date)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band dark">
    <div class="wrap grid c2" style="gap:3rem">
      <div>
        <p class="eyebrow" style="color:#9fb2c8">Pipeline</p>
        <h2>{active.length} programmes in development</h2>
        <p>From first studies in people to products waiting for regulatory approval.</p>
        <p><a class="btn" href="/pipeline/" style="background:#fff;color:#14243a">View pipeline</a></p>
      </div>
      <div class="grid c4" style="gap:1rem">
        {['I', 'II', 'III', 'Registration'].map((ph) => (
          <div style="border:1px solid #2c4160;padding:1rem">
            <div style="font:500 2.2rem var(--font-head)">{count(ph)}</div>
            <div class="small" style="color:#b9c6d6">{ph === 'Registration' ? 'Registration' : `Phase ${ph}`}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Investors</p>
      <div class="ticker">
        <div><span class="muted small">SIX: NEUS</span><div class="px">CHF {last.close.toFixed(2)}</div></div>
        <div class={`chg ${up ? 'up' : 'down'}`}>{up ? '+' : ''}{change.toFixed(2)} ({up ? '+' : ''}{changePct.toFixed(2)}%)</div>
        <div class="muted small">Close, {longDate(new Date(last.date))}</div>
      </div>
      <a href="/investors/">Investor information</a>
    </div>
  </section>
</Base>
